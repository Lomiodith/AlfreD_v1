# Copy to .env and fill in the secrets.

# ── Secrets ──
GROQ_API_KEY=

# ── Storage ──
# Where downloaded models are kept (leave empty for the default user cache)
MODELS_DIR=

# Where the Google OAuth client + token live (keep outside the synced project folder)
SECRETS_DIR=

# Folders searched for "open <file>", separated by ; on Windows (: elsewhere).
# Default: Desktop, Documents, Downloads and the AlfreD folder
FILE_SEARCH_DIRS=

# ── Assistant ──
WAKE_WORD=Alfred
WAKE_WORD_DURATION=1.5

# ── Speech-to-text ──
# Speech-to-text model: nvidia/parakeet-tdt-0.6b-v3 (multilingual, being tested) or distil-whisper/distil-large-v3.5 (English only)
STT_MODEL=nvidia/parakeet-tdt-0.6b-v3
# Languages you speak; a transcript in another one makes Alfred ask whether it was intended
ALLOWED_LANGUAGES=en,ro
# Smart Turn: end your turn at a short pause when you sound finished, instead of waiting SILENCE_SECONDS
SMART_TURN=true
SMART_TURN_PAUSE_SECONDS=0.5
SMART_TURN_THRESHOLD=0.5
SILENCE_SECONDS=2.0
MAX_RECORDING_SECONDS=20
# After each answer, seconds to wait for the next request without the wake word (silence ends the conversation)
FOLLOW_UP_SECONDS=5

# ── LLM ──
# Models tried in order (provider:model; provider = llamacpp or groq). The local model
# (started by AlfreD) answers; the Groq models take over when it fails
LLM_CHAIN=llamacpp:qwythos-9b,groq:openai/gpt-oss-120b,groq:qwen/qwen3.8-27b
# llama.cpp server AlfreD starts for a llamacpp: model. Fully on the GPU (-ngl 999);
# --spec-type draft-mtp uses the model's built-in multi-token prediction head for speed
LLAMACPP_URL=http://127.0.0.1:8080
LLAMACPP_SERVER=
LLAMACPP_MODEL=
LLAMACPP_ARGS=-ngl 999 -c 16384 --parallel 1 -fa on -ctk q8_0 -ctv q8_0 -t 8 -b 2048 -ub 2048 --spec-type draft-mtp --spec-draft-n-max 3 --reasoning-budget 512
LLM_TEMPERATURE=0.3
# Thinking before answering, per output mode: none / low / medium / high
# (Groq Qwen: below medium = off; local llama.cpp model: off only at none)
LLM_REASONING_VOICE=low
LLM_REASONING_TEXT=medium
LLM_MAX_TOKENS=1024
# Longer cap for text mode, where answers are shown in full
LLM_MAX_TOKENS_TEXT=4096

# ── Text-to-speech ──
TTS_VOICE=en-GB-RyanNeural
# edge (online, all languages) or kokoro (local, faster; English only, other languages still use edge)
TTS_ENGINE=kokoro
KOKORO_VOICE=bm_george
# cpu (frees ~0.3 GB of GPU memory, but ~1.3 s per sentence) or cuda (~0.15 s)
KOKORO_DEVICE=cuda
# true: short spoken answers; false: full answers printed only (switch live with "voice mode" / "text mode")
VOICE_OUTPUT=true

# ── Memory ──
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
MEMORY_MIN_SIMILARITY=0.35

# ── Logging ──
LOG_LEVEL=INFO
